\@writefile{lof}{\contentsline {figure}{\numberline {9.6}{\ignorespaces Every available threshold-sweep channel is a curve and every threshold is a point in the $(f,\ r_{\rm  proxy}/r_{\rm  tol})$ plane, with the residual on the fine-stage screening axis and the tolerance the stable dilation tier. The two tolerance boundaries are the two failure modes of this section: the \emph  {bias wall} (top edge: kept data too dirty) and the \emph  {occupancy wall} (right edge: nothing left to keep). Each dot is the positive-excess floor $\eta = 1$; raising $\eta $ walks a curve right-to-left. Dashed curves carry a stated (rather than measured) floor or a $\tau _c$ bound; the shaded band is where the $f\sigma _8$ wall falls, $10$--$25\times $ lower depending on bin. The $\times $ marks channel 35 restricted to 2022 onward: the same channel, moved to the other wall by a station switch-on (Section~\ref {sec:bao:eras}).}}{88}{figure.9.6}\protected@file@percent }
\newlabel{fig:bao:twowalls}{{9.6}{88}{Every available threshold-sweep channel is a curve and every threshold is a point in the $(f,\ r_{\rm proxy}/r_{\rm tol})$ plane, with the residual on the fine-stage screening axis and the tolerance the stable dilation tier. The two tolerance boundaries are the two failure modes of this section: the \emph {bias wall} (top edge: kept data too dirty) and the \emph {occupancy wall} (right edge: nothing left to keep). Each dot is the positive-excess floor $\eta = 1$; raising $\eta $ walks a curve right-to-left. Dashed curves carry a stated (rather than measured) floor or a $\tau _c$ bound; the shaded band is where the $f\sigma _8$ wall falls, $10$--$25\times $ lower depending on bin. The $\times $ marks channel 35 restricted to 2022 onward: the same channel, moved to the other wall by a station switch-on (Section~\ref {sec:bao:eras})}{figure.9.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.5}{\ignorespaces Three screening worlds: the growth-rate margin $r_{\rm  tol}(f\sigma _8)/r_{\rm  sys}$ on the threshold-feasible channels, with the residual at the minimum-residual operating point ($\eta = 1$, fine stage) and each world's tolerances re-derived from its own mode-cut bank (stability gate re-applied; the dilations pass for channels 32/33/35 in every world and are not tabulated). Margins $\ge 1$ (bold) pass. Channel 29 is shown for contrast: its $\tau _c$-capped residual fails every parameter in every world --- filtering is not its problem.}}{89}{table.9.5}\protected@file@percent }
\newlabel{tab:bao:worlds}{{9.5}{89}{Three screening worlds: the growth-rate margin $r_{\rm tol}(f\sigma _8)/r_{\rm sys}$ on the threshold-feasible channels, with the residual at the minimum-residual operating point ($\eta = 1$, fine stage) and each world's tolerances re-derived from its own mode-cut bank (stability gate re-applied; the dilations pass for channels 32/33/35 in every world and are not tabulated). Margins $\ge 1$ (bold) pass. Channel 29 is shown for contrast: its $\tau _c$-capped residual fails every parameter in every world --- filtering is not its problem}{table.9.5}{}}
